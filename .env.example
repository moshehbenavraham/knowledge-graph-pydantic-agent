# ===== SUPABASE (Primary Database) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ===== NEO4J (Knowledge Graph for Agentic RAG) =====
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io  # Use bolt://localhost:7687 for local
NEO4J_QUERY_API_URL=https://xxxxx.databases.neo4j.io/db/neo4j/query/v2
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=true                          # Use encrypted connection

# ===== LLM CONFIGURATION =====
LLM_PROVIDER=openai                           # openai, anthropic, openrouter, ollama
LLM_BASE_URL=https://api.openai.com/v1        # Not used for Anthropic
LLM_API_KEY=your_api_key_here                 # Your OpenAI/Anthropic/OpenRouter API key
LLM_MODEL=gpt-5-mini                          # Primary model name (gpt-5-mini, gpt-5, claude-sonnet-4-20250514, etc.)
LLM_CHOICE=gpt-5-mini                         # Legacy alias for LLM_MODEL
LLM_TEMPERATURE=0.7                            # Generation temperature (0.0-2.0)
LLM_MAX_TOKENS=2000                           # Maximum response tokens

# ===== EMBEDDING CONFIGURATION =====
EMBEDDING_PROVIDER=openai                     # openai, anthropic, ollama
EMBEDDING_BASE_URL=https://api.openai.com/v1  # Not used for Anthropic
EMBEDDING_API_KEY=your_api_key_here           # Your embedding API key (can be same as LLM_API_KEY for Anthropic)
EMBEDDING_MODEL=text-embedding-3-small        # Primary embedding model
EMBEDDING_MODEL_CHOICE=text-embedding-3-small # Legacy alias for EMBEDDING_MODEL
EMBEDDING_DIMENSION=1536                      # Embedding vector dimension
EMBEDDING_BATCH_SIZE=100                      # Batch size for embedding generation

# ===== DATABASE (Uses Supabase) =====
# For WSL2 or IPv4-only networks, use Session pooler (port 5432):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres
# Example: DATABASE_URL=postgresql://postgres.abcdefghijk:password123@aws-1-us-east-2.pooler.supabase.com:5432/postgres
# Note: URL-encode special characters in password (? → %3F, $ → %24, @ → %40)
# Direct connection (IPv6 only, not compatible with WSL2): postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ===== WEB SEARCH =====
# Priority: Jina > Brave > SearXNG (configure one or more)
JINA_API_KEY=                                 # Optional: Jina.ai API key for clean web content
BRAVE_API_KEY=                                # Optional: Brave Search API key
SEARXNG_BASE_URL=http://localhost:8080        # Optional: Self-hosted SearXNG instance
WEB_SEARCH_PROVIDER=                          # Optional: Force specific provider (jina/brave/searxng)

# ===== GOOGLE DRIVE (Optional) =====
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_PATH=config/google_credentials.json

# ===== UI CONFIGURATION =====
UI_MODE=standard                              # simple, standard, advanced

# ===== FEATURE FLAGS =====
ENABLE_CODE_EXECUTION=false
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_LONG_TERM_MEMORY=true
ENABLE_RAG=true
ENABLE_AGENTIC_RAG=true
ENABLE_GRAPH_SEARCH=true

# ===== VISION MODEL =====
VISION_LLM_CHOICE=gpt-5-mini                  # gpt-5-mini, gpt-5, claude-sonnet-4-20250514, etc.

# ===== MCP SERVER =====
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# ===== MONITORING =====
ENABLE_METRICS=true
METRICS_PORT=8000
HEALTH_CHECK_INTERVAL=30

# ===== PERFORMANCE =====
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=300
RATE_LIMIT_PER_MINUTE=60

# ===== INGESTION & CHUNKING SETTINGS =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=100
USE_SEMANTIC_CHUNKING=true
SEMANTIC_CHUNKING_MODEL=gpt-5-mini

# ===== EXTRACTION CONFIGURATION =====
EXTRACTION_MODEL=gpt-5-mini
EXTRACT_ENTITIES=true
EXTRACT_RELATIONSHIPS=true
EXTRACT_FACTS=true
MAX_ENTITIES_PER_CHUNK=10
MAX_FACTS_PER_CHUNK=5
MAX_FACT_LENGTH=500
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# ===== SEARCH CONFIGURATION =====
DEFAULT_SEARCH_LIMIT=10
VECTOR_SEARCH_THRESHOLD=0.7
VECTOR_SEARCH_TIMEOUT=2.0
GRAPH_SEARCH_TIMEOUT=3.0
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL=3600
PARALLEL_SEARCH_TIMEOUT=5

# ===== PERFORMANCE CONFIGURATION =====
ENABLE_GRAPH=true
ENABLE_CACHING=true
ENABLE_PARALLEL_SEARCH=true
EMBEDDING_CACHE_SIZE=1000
EMBEDDING_CACHE_TTL=3600
GRAPH_CACHE_SIZE=500
GRAPH_CACHE_TTL=1800
GRAPH_BATCH_SIZE=10                           # Batch size for graph operations

# ===== INGESTION PERFORMANCE =====
INGESTION_BATCH_SIZE=10
INGESTION_WORKERS=4
MAX_CONCURRENT_EMBEDDINGS=20
MAX_CONCURRENT_EXTRACTIONS=10

# ===== CONNECTION POOL CONFIGURATION =====
PG_POOL_MIN=5
PG_POOL_MAX=20
PG_MAX_QUERIES=50000
PG_MAX_INACTIVE_LIFETIME=300
PG_COMMAND_TIMEOUT=60
NEO4J_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30.0
NEO4J_MAX_RETRY_TIME=30

# ===== CIRCUIT BREAKER CONFIGURATION =====
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# ===== REDIS CACHE =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
ENABLE_REDIS_CACHE=true
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# ===== API CONFIGURATION =====
API_HOST=0.0.0.0
API_PORT=8058
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== MONITORING & OBSERVABILITY =====
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_HOST=localhost
JAEGER_PORT=6831
TRACING_ENABLED=true

# ===== DEVELOPMENT =====
DEBUG=false
DEVELOPMENT_MODE=false
HOT_RELOAD=false
APP_ENV=development                           # development, testing, production

# ===== LOAD TESTING =====
LOCUST_HOST=http://localhost:8058
LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_RUN_TIME=5m

# ===== PERFORMANCE =====
CONNECTION_POOL_SIZE=20
REQUEST_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60
