# ===== SUPABASE (Primary Database) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ===== NEO4J (Knowledge Graph for Agentic RAG) =====
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io  # Use bolt://localhost:7687 for local
NEO4J_QUERY_API_URL=https://xxxxx.databases.neo4j.io/db/neo4j/query/v2
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=true                          # Use encrypted connection

# ===== LLM CONFIGURATION =====
LLM_PROVIDER=openai                           # openai, anthropic, openrouter, ollama
LLM_BASE_URL=https://api.openai.com/v1        # Not used for Anthropic
LLM_API_KEY=your_api_key_here                 # Your OpenAI/Anthropic/OpenRouter API key
LLM_MODEL=gpt-5-mini                          # Primary model name (gpt-5-mini, gpt-5, claude-sonnet-4-20250514, etc.)
LLM_CHOICE=gpt-5-mini                         # Legacy alias for LLM_MODEL
LLM_TEMPERATURE=0.7                            # Generation temperature (0.0-2.0)
LLM_MAX_TOKENS=2000                           # Maximum response tokens

# ===== EMBEDDING CONFIGURATION =====
EMBEDDING_PROVIDER=openai                     # openai, anthropic, ollama
EMBEDDING_BASE_URL=https://api.openai.com/v1  # Not used for Anthropic
EMBEDDING_API_KEY=your_api_key_here           # Your embedding API key (can be same as LLM_API_KEY for Anthropic)
EMBEDDING_MODEL=text-embedding-3-small        # Primary embedding model
EMBEDDING_MODEL_CHOICE=text-embedding-3-small # Legacy alias for EMBEDDING_MODEL
EMBEDDING_DIMENSION=1536                      # Embedding vector dimension
EMBEDDING_BATCH_SIZE=100                      # Batch size for embedding generation

# ===== DATABASE (Uses Supabase) =====
# For WSL2 or IPv4-only networks, use Session pooler (port 5432):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres
# Example: DATABASE_URL=postgresql://postgres.abcdefghijk:password123@aws-1-us-east-2.pooler.supabase.com:5432/postgres
# Note: URL-encode special characters in password (? → %3F, $ → %24, @ → %40)
# Direct connection (IPv6 only, not compatible with WSL2): postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ===== WEB SEARCH =====
# Priority: Jina > Brave > SearXNG (configure one or more)
JINA_API_KEY=                                 # Optional: Jina.ai API key for clean web content
BRAVE_API_KEY=                                # Optional: Brave Search API key
SEARXNG_BASE_URL=http://localhost:8080        # Optional: Self-hosted SearXNG instance
WEB_SEARCH_PROVIDER=                          # Optional: Force specific provider (jina/brave/searxng)

# ===== GOOGLE DRIVE (Optional) =====
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_PATH=config/google_credentials.json

# ===== UI CONFIGURATION =====
UI_MODE=standard                              # simple, standard, advanced

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501                    # Port for Streamlit UI
STREAMLIT_SERVER_ADDRESS=0.0.0.0              # Server address (0.0.0.0 for all interfaces)
STREAMLIT_SERVER_HEADLESS=true                # Run in headless mode (production)
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false    # Disable usage statistics collection

# ===== NGROK DEPLOYMENT =====
NGROK_AUTHTOKEN=your_ngrok_authtoken_here     # Get from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_DOMAIN=your-custom-domain.ngrok.io      # Your ngrok custom domain (Personal/Pro plan)
NGROK_ENABLED=false                            # Enable ngrok tunnel on startup

# ===== FEATURE FLAGS =====
ENABLE_CODE_EXECUTION=false
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_LONG_TERM_MEMORY=true
ENABLE_RAG=true
ENABLE_AGENTIC_RAG=true
ENABLE_GRAPH_SEARCH=true

# ===== VISION MODEL =====
VISION_LLM_CHOICE=gpt-5-mini                  # gpt-5-mini, gpt-5, claude-sonnet-4-20250514, etc.

# ===== MCP SERVER =====
MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost

# ===== APPLICATION =====
APP_VERSION=0.1.0

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true

# ===== MONITORING =====
ENABLE_METRICS=true
METRICS_PORT=8000
HEALTH_CHECK_INTERVAL=30

# ===== PERFORMANCE =====
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=300
RATE_LIMIT_PER_MINUTE=60

# ===== INGESTION & CHUNKING SETTINGS =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=100
USE_SEMANTIC_CHUNKING=true
SEMANTIC_CHUNKING_MODEL=gpt-5-mini

# ===== EXTRACTION CONFIGURATION =====
EXTRACTION_MODEL=gpt-5-mini
EXTRACT_ENTITIES=true
EXTRACT_RELATIONSHIPS=true
EXTRACT_FACTS=true
MAX_ENTITIES_PER_CHUNK=10
MAX_FACTS_PER_CHUNK=5
MAX_FACT_LENGTH=500
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# ===== SEARCH CONFIGURATION =====
DEFAULT_SEARCH_LIMIT=10                       # Default number of search results
VECTOR_SEARCH_LIMIT=10                        # Maximum vector search results
GRAPH_SEARCH_LIMIT=10                         # Maximum graph search results
VECTOR_SEARCH_THRESHOLD=0.7                   # Minimum similarity threshold for vector search
VECTOR_SEARCH_TIMEOUT=2.0                     # Vector search timeout in seconds
GRAPH_SEARCH_TIMEOUT=3.0                      # Graph search timeout in seconds
HYBRID_SEARCH_ALPHA=0.7                       # Hybrid search weight (0.0=graph only, 1.0=vector only)
ENABLE_SEARCH_CACHE=true                      # Enable search result caching
SEARCH_CACHE_TTL=3600                         # Cache time-to-live in seconds
PARALLEL_SEARCH_TIMEOUT=5                     # Timeout for parallel search operations

# ===== PERFORMANCE CONFIGURATION =====
ENABLE_GRAPH=true
ENABLE_CACHING=true
ENABLE_PARALLEL_SEARCH=true
EMBEDDING_CACHE_SIZE=1000
EMBEDDING_CACHE_TTL=3600
GRAPH_CACHE_SIZE=500
GRAPH_CACHE_TTL=1800
GRAPH_BATCH_SIZE=10                           # Batch size for graph operations

# ===== INGESTION PERFORMANCE =====
INGESTION_BATCH_SIZE=10
INGESTION_WORKERS=4
MAX_CONCURRENT_EMBEDDINGS=20
MAX_CONCURRENT_EXTRACTIONS=10

# ===== CONNECTION POOL CONFIGURATION =====
# PostgreSQL/Supabase Connection Pooling
PG_POOL_MIN=5                                 # Minimum pool size (also: PG_POOL_MIN_SIZE)
PG_POOL_MAX=20                                # Maximum pool size (also: PG_POOL_MAX_SIZE)
PG_POOL_MIN_SIZE=5                            # Alias for PG_POOL_MIN
PG_POOL_MAX_SIZE=20                           # Alias for PG_POOL_MAX
PG_POOL_TIMEOUT=10.0                          # Pool connection timeout in seconds
PG_MAX_QUERIES=50000                          # Max queries per connection
PG_MAX_INACTIVE_LIFETIME=300                  # Max inactive connection lifetime
PG_COMMAND_TIMEOUT=60                         # Command execution timeout

# Neo4j Connection Pooling
NEO4J_POOL_SIZE=50                            # Connection pool size (also: NEO4J_MAX_CONNECTION_POOL_SIZE)
NEO4J_MAX_CONNECTION_POOL_SIZE=50             # Alias for NEO4J_POOL_SIZE
NEO4J_CONNECTION_TIMEOUT=30.0                 # Connection timeout in seconds
NEO4J_MAX_RETRY_TIME=30                       # Maximum retry time for failed connections

# ===== CIRCUIT BREAKER CONFIGURATION =====
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# ===== REDIS CACHE =====
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
ENABLE_REDIS_CACHE=true
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# ===== API CONFIGURATION =====
API_HOST=0.0.0.0                              # API server host
API_PORT=8058                                 # API server port
API_WORKERS=4                                 # Number of Uvicorn worker processes
API_RELOAD=false                              # Enable auto-reload (development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080  # Allowed CORS origins

# ===== MONITORING & OBSERVABILITY =====
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces
JAEGER_HOST=localhost
JAEGER_PORT=6831
TRACING_ENABLED=true

# ===== DEVELOPMENT =====
DEBUG=false
DEVELOPMENT_MODE=false
HOT_RELOAD=false
APP_ENV=development                           # development, testing, production

# ===== TESTING CONFIGURATION =====
ENABLE_INTEGRATION_TESTS=false                # Enable database integration tests (WARNING: uses configured database)

# ===== LOAD TESTING =====
LOCUST_HOST=http://localhost:8058
LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_RUN_TIME=5m

# ===== PERFORMANCE =====
CONNECTION_POOL_SIZE=20
REQUEST_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_ENABLED=true                       # Enable rate limiting
RATE_LIMIT_PER_MINUTE=60                      # Max requests per minute per user/IP

# ===== AUTHENTICATION =====
USE_DATABASE_AUTH=false                       # Toggle between database (true) and YAML (false) backends
AUTH_COOKIE_KEY=                              # Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Cookie Settings (adjust domain for your deployment)
AUTH_COOKIE_NAME=base_agent_auth              # Cookie name for authentication
AUTH_COOKIE_EXPIRY_DAYS=30                    # Cookie expiration in days
AUTH_COOKIE_DOMAIN=                           # Cookie domain (e.g., your-app.yourdomain.com, leave empty for localhost)
AUTH_COOKIE_SECURE=true                       # Use secure cookies (HTTPS only) - set false for localhost
AUTH_COOKIE_HTTPONLY=true                     # HTTP-only cookies (prevent JS access)

# Session Settings
SESSION_IDLE_TIMEOUT_MINUTES=30               # Idle timeout before session expires
SESSION_ABSOLUTE_TIMEOUT_HOURS=24             # Maximum session duration

# ===== OAUTH AUTHENTICATION (Optional - requires USE_DATABASE_AUTH=true) =====
OAUTH_ENABLED=false                           # Enable OAuth login (Google, GitHub, Microsoft, Apple)
OAUTH_ENCRYPTION_KEY=                         # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Google OAuth
GOOGLE_CLIENT_ID=                             # From Google Cloud Console
GOOGLE_CLIENT_SECRET=                         # From Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8501     # OAuth callback URL (update for production)

# GitHub OAuth
GITHUB_CLIENT_ID=                             # From GitHub OAuth Apps settings
GITHUB_CLIENT_SECRET=                         # From GitHub OAuth Apps settings
GITHUB_REDIRECT_URI=http://localhost:8501     # OAuth callback URL (update for production)

# Microsoft OAuth (v2.0.0+)
MICROSOFT_CLIENT_ID=                          # From Azure App Registration
MICROSOFT_CLIENT_SECRET=                      # From Azure App Registration
MICROSOFT_REDIRECT_URI=http://localhost:8501  # OAuth callback URL (update for production)

# Apple OAuth (v2.0.0+)
APPLE_CLIENT_ID=                              # From Apple Developer Console (Service ID)
APPLE_CLIENT_SECRET=                          # Generated JWT token signed with private key
APPLE_REDIRECT_URI=http://localhost:8501      # OAuth callback URL (update for production)

# Password Reset & Email Verification (requires USE_DATABASE_AUTH=true)
PASSWORD_RESET_URL=http://localhost:8501/reset-password  # Base URL for password reset completion page
VERIFICATION_URL=http://localhost:8501        # Base URL for email verification (will append ?token=...&action=verify)
EMAIL_ENABLED=false                           # Enable email sending for password reset and verification
EMAIL_PROVIDER=smtp                           # smtp, sendgrid, mailgun
SMTP_HOST=smtp.gmail.com                      # SMTP server host
SMTP_PORT=587                                 # SMTP server port
SMTP_USER=                                    # SMTP username
SMTP_PASSWORD=                                # SMTP password (Gmail: Use App Password with 2FA)
SMTP_FROM_EMAIL=noreply@luminariagent.local       # From email address

# ===== TWO-FACTOR AUTHENTICATION (v2.0.0+) =====
# TOTP 2FA (requires USE_DATABASE_AUTH=true)
TOTP_ENCRYPTION_KEY=                          # Uses OAUTH_ENCRYPTION_KEY if not specified
TOTP_ISSUER_NAME=Luminari Agent                   # Name shown in authenticator app

# Backup Codes
BACKUP_CODE_COUNT=10                          # Number of backup codes to generate
BACKUP_CODE_LENGTH=8                          # Length of each backup code
BACKUP_CODE_EXPIRY_DAYS=90                    # Days until backup codes expire

# ===== CAPTCHA CONFIGURATION (v2.0.0+) =====
# CAPTCHA after failed login attempts (requires USE_DATABASE_AUTH=true)
CAPTCHA_ENABLED=false                         # Enable CAPTCHA on login after failed attempts
CAPTCHA_THRESHOLD=3                           # Number of failed attempts before showing CAPTCHA
CAPTCHA_PROVIDER=hcaptcha                     # hcaptcha, recaptcha_v2, recaptcha_v3

# hCaptcha (recommended - privacy-friendly)
HCAPTCHA_SITE_KEY=                            # From hCaptcha.com
HCAPTCHA_SECRET_KEY=                          # From hCaptcha.com

# Google reCAPTCHA (alternative)
RECAPTCHA_SITE_KEY=                           # From Google reCAPTCHA admin
RECAPTCHA_SECRET_KEY=                         # From Google reCAPTCHA admin

# ===== PASSWORD SECURITY (v2.0.0+) =====
# Password History (requires USE_DATABASE_AUTH=true)
PASSWORD_HISTORY_COUNT=5                      # Number of previous passwords to prevent reuse
PASSWORD_HISTORY_ENABLED=true                 # Enforce password history checking

# Breach Detection (haveibeenpwned.com API)
BREACH_DETECTION_ENABLED=true                 # Check passwords against breach database
BREACH_CHECK_INTERVAL_DAYS=30                 # Days between automatic breach checks
BREACH_CHECK_ON_REGISTRATION=true             # Check password on user registration
BREACH_CHECK_ON_LOGIN=false                   # Check password on every login (may slow down login)
BREACH_CHECK_ON_PASSWORD_CHANGE=true          # Check password when user changes it
