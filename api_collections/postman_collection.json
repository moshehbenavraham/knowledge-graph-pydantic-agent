{
  "info": {
    "_postman_id": "agentic-rag-api-v1",
    "name": "Agentic RAG API",
    "description": "Complete API collection for the Agentic RAG System with vector search, knowledge graphs, and AI agent capabilities",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8058",
      "type": "string"
    },
    {
      "key": "api_version",
      "value": "v1",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "{{$guid}}",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set dynamic timestamp",
          "pm.variables.set('timestamp', new Date().toISOString());",
          "",
          "// Generate request ID",
          "pm.variables.set('request_id', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common response tests",
          "pm.test('Response time is less than 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test('Response has valid content type', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "API Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "status"]
            }
          },
          "response": []
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics",
              "host": ["{{base_url}}"],
              "path": ["metrics"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Chat Operations",
      "item": [
        {
          "name": "Simple Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"Hello, can you help me understand RAG systems?\",\n    \"session_id\": \"{{session_id}}\",\n    \"include_sources\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "chat"]
            }
          },
          "response": []
        },
        {
          "name": "Chat with Tools",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"Search for information about vector databases and explain how they work\",\n    \"session_id\": \"{{session_id}}\",\n    \"stream\": false,\n    \"include_sources\": true,\n    \"search_strategy\": \"hybrid\",\n    \"max_tokens\": 2000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "chat"]
            }
          },
          "response": []
        },
        {
          "name": "Streaming Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"Explain the architecture of this RAG system in detail\",\n    \"session_id\": \"{{session_id}}\",\n    \"stream\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/chat/stream",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "chat", "stream"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Search Operations",
      "item": [
        {
          "name": "Vector Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"machine learning algorithms\",\n    \"search_type\": \"vector\",\n    \"limit\": 10,\n    \"threshold\": 0.7\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/search",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "search"]
            }
          },
          "response": []
        },
        {
          "name": "Graph Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"OpenAI relationships\",\n    \"search_type\": \"graph\",\n    \"limit\": 10,\n    \"threshold\": 0.6\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/search",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "search"]
            }
          },
          "response": []
        },
        {
          "name": "Hybrid Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"AI safety and alignment research\",\n    \"search_type\": \"hybrid\",\n    \"limit\": 15,\n    \"threshold\": 0.75\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/search",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "search"]
            }
          },
          "response": []
        },
        {
          "name": "Smart Search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"What companies are investing in AI?\",\n    \"search_type\": \"smart\",\n    \"limit\": 20\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/search/smart",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "search", "smart"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Document Management",
      "item": [
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/document.pdf"
                },
                {
                  "key": "metadata",
                  "value": "{\"source\": \"manual_upload\", \"category\": \"technical\"}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "documents", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/documents/:document_id",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "documents", ":document_id"],
              "variable": [
                {
                  "key": "document_id",
                  "value": "doc_123"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/documents?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "documents"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/documents/:document_id",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "documents", ":document_id"],
              "variable": [
                {
                  "key": "document_id",
                  "value": "doc_123"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ingestion Pipeline",
      "item": [
        {
          "name": "Start Ingestion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"source_path\": \"/path/to/documents\",\n    \"clean_existing\": false,\n    \"chunk_size\": 1000,\n    \"chunk_overlap\": 200\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/ingestion/start",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "ingestion", "start"]
            }
          },
          "response": []
        },
        {
          "name": "Get Ingestion Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/ingestion/status/:job_id",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "ingestion", "status", ":job_id"],
              "variable": [
                {
                  "key": "job_id",
                  "value": "job_123"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cache Management",
      "item": [
        {
          "name": "Get Cache Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/cache/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "cache", "stats"]
            }
          },
          "response": []
        },
        {
          "name": "Clear Cache",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pattern\": \"*search*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/cache/clear",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "cache", "clear"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Memory Operations",
      "item": [
        {
          "name": "Get Session Memory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/memory/:session_id",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "memory", ":session_id"],
              "variable": [
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Clear Session Memory",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/memory/:session_id",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "memory", ":session_id"],
              "variable": [
                {
                  "key": "session_id",
                  "value": "{{session_id}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}