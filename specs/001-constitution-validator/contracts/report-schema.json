{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://base-agent.local/schemas/constitution-validator/report.json",
  "title": "Constitution Compliance Report",
  "description": "Structured output format for the Constitution Compliance Validator CLI tool. This report groups violations by constitutional principle and type, listing all affected file locations for each violation type.",
  "type": "object",
  "required": [
    "version",
    "timestamp",
    "status",
    "summary",
    "violations",
    "metadata"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version for backwards compatibility (semantic versioning)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["1.0.0"]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of when validation was performed",
      "format": "date-time",
      "examples": ["2025-10-21T14:30:00Z"]
    },
    "status": {
      "type": "string",
      "description": "Overall compliance status. PASS means no violations found (exit 0), FAIL means violations detected (exit non-zero)",
      "enum": ["PASS", "FAIL"],
      "examples": ["PASS", "FAIL"]
    },
    "summary": {
      "type": "object",
      "description": "High-level statistics about the validation run",
      "required": [
        "total_violations",
        "total_files_scanned",
        "total_files_with_violations",
        "validation_duration_ms",
        "principles_violated"
      ],
      "properties": {
        "total_violations": {
          "type": "integer",
          "description": "Total count of violation instances across all principles",
          "minimum": 0,
          "examples": [0, 12, 45]
        },
        "total_files_scanned": {
          "type": "integer",
          "description": "Total number of files analyzed during validation",
          "minimum": 0,
          "examples": [250, 1500]
        },
        "total_files_with_violations": {
          "type": "integer",
          "description": "Count of unique files containing at least one violation",
          "minimum": 0,
          "examples": [0, 5, 23]
        },
        "validation_duration_ms": {
          "type": "number",
          "description": "Total time taken for validation in milliseconds",
          "minimum": 0,
          "examples": [1250.5, 28340.2]
        },
        "principles_violated": {
          "type": "array",
          "description": "List of constitutional principle identifiers that had violations",
          "items": {
            "type": "string",
            "enum": [
              "PRINCIPLE_I",
              "PRINCIPLE_II",
              "PRINCIPLE_III",
              "PRINCIPLE_IV",
              "PRINCIPLE_V",
              "PRINCIPLE_VI"
            ]
          },
          "uniqueItems": true,
          "examples": [[], ["PRINCIPLE_II", "PRINCIPLE_IV"]]
        }
      },
      "additionalProperties": false
    },
    "violations": {
      "type": "array",
      "description": "Array of violation groups, each representing a specific type of constitutional violation with all affected locations",
      "items": {
        "$ref": "#/definitions/ViolationGroup"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional context about the validation environment and configuration",
      "required": [
        "validator_version",
        "python_version",
        "constitution_file",
        "target_paths",
        "ignored_patterns"
      ],
      "properties": {
        "validator_version": {
          "type": "string",
          "description": "Version of the constitution validator tool",
          "examples": ["1.0.0", "1.2.3"]
        },
        "python_version": {
          "type": "string",
          "description": "Python interpreter version used for validation",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "examples": ["3.11.5", "3.12.0"]
        },
        "constitution_file": {
          "type": "string",
          "description": "Absolute path to the constitution file used as validation source",
          "examples": ["/home/user/project/.specify/memory/constitution.md"]
        },
        "target_paths": {
          "type": "array",
          "description": "List of file paths or directories that were validated (empty array means full codebase)",
          "items": {
            "type": "string"
          },
          "examples": [[], ["src/agent/", "src/config/settings.py"]]
        },
        "ignored_patterns": {
          "type": "array",
          "description": "List of file patterns excluded from validation via .constitution-ignore",
          "items": {
            "type": "string"
          },
          "examples": [["*.pyc", "__pycache__/", "node_modules/"]]
        },
        "cli_flags": {
          "type": "object",
          "description": "Optional CLI flags used during validation",
          "properties": {
            "verbose": {
              "type": "boolean",
              "description": "Whether verbose mode was enabled"
            },
            "quiet": {
              "type": "boolean",
              "description": "Whether quiet mode was enabled"
            },
            "dry_run": {
              "type": "boolean",
              "description": "Whether dry-run mode was used"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ViolationGroup": {
      "type": "object",
      "description": "A group of violations of the same type, with all file locations where this violation occurred",
      "required": [
        "principle_id",
        "principle_name",
        "violation_type",
        "violation_description",
        "severity",
        "locations",
        "remediation"
      ],
      "properties": {
        "principle_id": {
          "type": "string",
          "description": "Constitutional principle identifier (I through VI)",
          "enum": [
            "PRINCIPLE_I",
            "PRINCIPLE_II",
            "PRINCIPLE_III",
            "PRINCIPLE_IV",
            "PRINCIPLE_V",
            "PRINCIPLE_VI"
          ],
          "examples": ["PRINCIPLE_II"]
        },
        "principle_name": {
          "type": "string",
          "description": "Human-readable principle name",
          "examples": [
            "Unified Agent Architecture",
            "Type-Safe Centralized Configuration",
            "Dual-Database Agentic RAG",
            "Test-Driven Quality Assurance",
            "Production-Ready Observability",
            "Git Attribution & Contribution Standards"
          ]
        },
        "violation_type": {
          "type": "string",
          "description": "Specific type of violation within the principle (used for grouping)",
          "examples": [
            "direct_os_getenv_usage",
            "multiple_agent_files",
            "missing_test_coverage",
            "ai_attribution_in_commits",
            "missing_logging"
          ]
        },
        "violation_description": {
          "type": "string",
          "description": "Clear explanation of what rule was violated",
          "examples": [
            "Direct use of os.getenv() instead of centralized configuration",
            "Multiple agent implementation files detected (violates unified agent architecture)"
          ]
        },
        "severity": {
          "type": "string",
          "description": "Severity level of the violation",
          "enum": ["ERROR", "WARNING", "INFO"],
          "examples": ["ERROR", "WARNING"]
        },
        "locations": {
          "type": "array",
          "description": "All file locations where this specific violation type was found",
          "items": {
            "$ref": "#/definitions/ViolationLocation"
          },
          "minItems": 1
        },
        "remediation": {
          "type": "object",
          "description": "Actionable guidance for fixing this violation type",
          "required": ["steps", "constitutional_reference"],
          "properties": {
            "steps": {
              "type": "array",
              "description": "Ordered list of remediation steps",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "examples": [
                [
                  "Move configuration to src/config/settings.py",
                  "Use get_settings() to access configuration values",
                  "Remove all os.getenv() calls"
                ]
              ]
            },
            "constitutional_reference": {
              "type": "string",
              "description": "Quote or reference from the constitution explaining why this is prohibited",
              "examples": [
                "Constitution Principle II: 'NEVER use os.getenv() directly - always use the centralized configuration via get_settings()'"
              ]
            },
            "code_example": {
              "type": "string",
              "description": "Optional code snippet showing correct implementation",
              "examples": [
                "from src.config import get_settings\nsettings = get_settings()\napi_key = settings.api_key"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ViolationLocation": {
      "type": "object",
      "description": "Specific location of a violation instance",
      "required": ["file_path", "line_number"],
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Relative path from repository root to the file containing the violation",
          "examples": ["src/tools/web_search.py", "tests/test_agent.py"]
        },
        "line_number": {
          "type": "integer",
          "description": "Line number where violation was detected (0 if not line-specific)",
          "minimum": 0,
          "examples": [42, 156, 0]
        },
        "column_number": {
          "type": "integer",
          "description": "Optional column number for precise location",
          "minimum": 0,
          "examples": [15, 8]
        },
        "code_snippet": {
          "type": "string",
          "description": "Optional excerpt of the offending code",
          "examples": ["api_key = os.getenv('API_KEY')"]
        },
        "context": {
          "type": "string",
          "description": "Optional additional context about this specific violation instance",
          "examples": ["Found in function initialize_client()"]
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "version": "1.0.0",
      "timestamp": "2025-10-21T14:30:00Z",
      "status": "PASS",
      "summary": {
        "total_violations": 0,
        "total_files_scanned": 342,
        "total_files_with_violations": 0,
        "validation_duration_ms": 12450.5,
        "principles_violated": []
      },
      "violations": [],
      "metadata": {
        "validator_version": "1.0.0",
        "python_version": "3.11.5",
        "constitution_file": "/home/user/project/.specify/memory/constitution.md",
        "target_paths": [],
        "ignored_patterns": ["*.pyc", "__pycache__/", "node_modules/"],
        "cli_flags": {
          "verbose": false,
          "quiet": false,
          "dry_run": false
        }
      }
    },
    {
      "version": "1.0.0",
      "timestamp": "2025-10-21T15:45:23Z",
      "status": "FAIL",
      "summary": {
        "total_violations": 8,
        "total_files_scanned": 342,
        "total_files_with_violations": 5,
        "validation_duration_ms": 13200.8,
        "principles_violated": ["PRINCIPLE_II", "PRINCIPLE_IV", "PRINCIPLE_V"]
      },
      "violations": [
        {
          "principle_id": "PRINCIPLE_II",
          "principle_name": "Type-Safe Centralized Configuration",
          "violation_type": "direct_os_getenv_usage",
          "violation_description": "Direct use of os.getenv() instead of centralized configuration",
          "severity": "ERROR",
          "locations": [
            {
              "file_path": "src/tools/web_search.py",
              "line_number": 42,
              "column_number": 15,
              "code_snippet": "api_key = os.getenv('BRAVE_API_KEY')",
              "context": "Found in function initialize_brave_client()"
            },
            {
              "file_path": "src/agent/custom_tool.py",
              "line_number": 156,
              "column_number": 20,
              "code_snippet": "token = os.getenv('CUSTOM_TOKEN')",
              "context": "Found in function authenticate()"
            },
            {
              "file_path": "tests/test_integration.py",
              "line_number": 89,
              "code_snippet": "test_key = os.getenv('TEST_API_KEY')"
            }
          ],
          "remediation": {
            "steps": [
              "Move configuration to src/config/settings.py",
              "Use get_settings() to access configuration values",
              "Remove all os.getenv() calls"
            ],
            "constitutional_reference": "Constitution Principle II: 'NEVER use os.getenv() directly - always use the centralized configuration via get_settings()'",
            "code_example": "from src.config import get_settings\nsettings = get_settings()\napi_key = settings.brave_api_key"
          }
        },
        {
          "principle_id": "PRINCIPLE_IV",
          "principle_name": "Test-Driven Quality Assurance",
          "violation_type": "insufficient_test_coverage",
          "violation_description": "Test coverage below required 75% threshold",
          "severity": "ERROR",
          "locations": [
            {
              "file_path": "src/tools/new_feature.py",
              "line_number": 0,
              "context": "Coverage: 45% (threshold: 75%)"
            }
          ],
          "remediation": {
            "steps": [
              "Add unit tests for all public functions in new_feature.py",
              "Add integration tests for main workflows",
              "Run 'pytest --cov=src/tools/new_feature.py --cov-report=term-missing' to identify untested lines"
            ],
            "constitutional_reference": "Constitution Principle IV: 'Test coverage minimum: 75% (enforced by pytest-cov)'"
          }
        },
        {
          "principle_id": "PRINCIPLE_V",
          "principle_name": "Production-Ready Observability",
          "violation_type": "missing_logging",
          "violation_description": "Public functions lack structured logging statements",
          "severity": "WARNING",
          "locations": [
            {
              "file_path": "src/tools/new_feature.py",
              "line_number": 25,
              "context": "Function 'process_data' has no logger calls"
            },
            {
              "file_path": "src/tools/new_feature.py",
              "line_number": 58,
              "context": "Function 'validate_input' has no logger calls"
            }
          ],
          "remediation": {
            "steps": [
              "Import structlog logger: 'import structlog; logger = structlog.get_logger()'",
              "Add logger.info() calls for major operations",
              "Add logger.exception() for error handling"
            ],
            "constitutional_reference": "Constitution Principle V: 'The application uses structlog for structured, context-rich logging throughout the Streamlit UI and all handler classes.'",
            "code_example": "import structlog\nlogger = structlog.get_logger()\n\ndef process_data():\n    logger.info('Processing data started', record_count=len(data))\n    # ... implementation\n    logger.info('Processing complete')"
          }
        }
      ],
      "metadata": {
        "validator_version": "1.0.0",
        "python_version": "3.11.5",
        "constitution_file": "/home/user/project/.specify/memory/constitution.md",
        "target_paths": ["src/tools/"],
        "ignored_patterns": ["*.pyc", "__pycache__/"],
        "cli_flags": {
          "verbose": true,
          "quiet": false,
          "dry_run": false
        }
      }
    }
  ]
}
