# Streamlit Authenticator Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to auth_config.yaml: cp config/auth_config.yaml.example config/auth_config.yaml
# 2. Generate a secure cookie key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Create users with: python -m src.auth.user_manager create --username USER --email EMAIL --name NAME --password PASS
# 4. Update settings below as needed for your environment
#
# SECURITY WARNING: Never commit auth_config.yaml to git! (it's in .gitignore)

# Cookie configuration for session management
cookie:
  name: "luminari_agent_auth_cookie"
  # REQUIRED: Generate a random key for production
  # Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
  key: "CHANGE_ME_TO_RANDOM_STRING_32_CHARS"
  expiry_days: 30

  # PRODUCTION SECURITY: Set secure=true when deploying with HTTPS
  # - For ngrok deployment (HTTPS): Set to true
  # - For local development (HTTP): Keep as false
  secure: false

# User credentials (bcrypt hashed passwords)
# DO NOT manually edit this section - use the user_manager CLI instead
credentials:
  usernames:
    # Example user structure (create with: python -m src.auth.user_manager create ...)
    # admin:
    #   email: "admin@example.com"
    #   name: "Administrator"
    #   password: "$2b$12$..."  # Bcrypt hash generated by user_manager

# Pre-authorization (optional whitelist)
# Add email addresses that should be pre-authorized
preauthorized:
  emails: []
  # Example:
  # emails:
  #   - "user1@example.com"
  #   - "user2@example.com"

# Configuration settings
config:
  # Logout button location
  logout_button_location: "sidebar"  # Options: sidebar, main, unrendered

  # Auto-logout settings
  auto_logout: true
  auto_logout_minutes: 30  # Idle timeout in minutes

  # Security settings
  bcrypt_log_rounds: 12  # Higher = more secure but slower (10-14 recommended)

  # Rate limiting (implemented in src/auth/security.py)
  max_login_attempts: 5
  lockout_duration_minutes: 15

# OAuth Configuration (optional - reserved for future use)
oauth:
  enabled: false
  providers:
    google:
      client_id: ""
      client_secret: ""
    github:
      client_id: ""
      client_secret: ""
