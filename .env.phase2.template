# ===== Agentic RAG Phase 2 Configuration Template =====
# Copy this file to .env and update with your actual values

# ===== Database Configuration =====
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_rag
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# ===== Neo4j Configuration =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=true

# ===== LLM Configuration =====
LLM_PROVIDER=openai  # openai|anthropic|ollama|gemini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ===== Extraction Model (can be different/cheaper) =====
EXTRACTION_MODEL=gpt-4o-mini
SEMANTIC_CHUNKING_MODEL=gpt-4o-mini

# ===== Embedding Configuration =====
EMBEDDING_PROVIDER=openai  # openai|nomic|ollama|cohere
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-api-key  # Can be same as LLM_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536  # 1536 for OpenAI, 768 for Nomic
EMBEDDING_BATCH_SIZE=100

# ===== Ingestion Configuration =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNK_SIZE=2000
MIN_CHUNK_SIZE=100
USE_SEMANTIC_CHUNKING=true
SEMANTIC_CHUNKING_MODEL=gpt-4o-mini

# ===== Extraction Configuration =====
EXTRACT_ENTITIES=true
EXTRACT_RELATIONSHIPS=true
EXTRACT_FACTS=true
MAX_ENTITIES_PER_CHUNK=10
MAX_FACTS_PER_CHUNK=5
MAX_FACT_LENGTH=500
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# ===== Search Configuration =====
DEFAULT_SEARCH_LIMIT=10
VECTOR_SEARCH_THRESHOLD=0.7
VECTOR_SEARCH_TIMEOUT=2.0
GRAPH_SEARCH_TIMEOUT=3.0
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL=3600
PARALLEL_SEARCH_TIMEOUT=5

# ===== Performance Configuration =====
ENABLE_GRAPH=true  # Can disable for vector-only mode
ENABLE_CACHING=true
ENABLE_PARALLEL_SEARCH=true
EMBEDDING_CACHE_SIZE=1000
EMBEDDING_CACHE_TTL=3600
GRAPH_CACHE_SIZE=500
GRAPH_CACHE_TTL=1800

# ===== Ingestion Performance =====
INGESTION_BATCH_SIZE=10
INGESTION_WORKERS=4
MAX_CONCURRENT_EMBEDDINGS=20
MAX_CONCURRENT_EXTRACTIONS=10

# ===== Connection Pool Configuration =====
PG_POOL_MIN=5
PG_POOL_MAX=20
PG_MAX_QUERIES=50000
PG_MAX_INACTIVE_LIFETIME=300
PG_COMMAND_TIMEOUT=60
NEO4J_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30.0
NEO4J_MAX_RETRY_TIME=30

# ===== Circuit Breaker Configuration =====
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# ===== Redis Cache (Optional) =====
REDIS_URL=redis://localhost:6379
ENABLE_REDIS_CACHE=false
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5

# ===== API Configuration =====
API_HOST=0.0.0.0
API_PORT=8058
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
APP_ENV=development  # development|production

# ===== Monitoring & Observability =====
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
