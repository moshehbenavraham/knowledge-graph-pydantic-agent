# ===============================================
# Multi-Stage Production Dockerfile
# Luminari Agent - Agentic RAG Platform
# ===============================================

# -----------------------------------------------
# Stage 1: Builder - Compile dependencies
# -----------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    build-essential \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install uv for faster dependency resolution (avoids pip backtracking)
RUN pip install --no-cache-dir uv

# Copy dependency specifications
COPY pyproject.toml README.md ./

# Copy source code (needed for installation)
COPY src/ ./src/

# Install the package with ALL optional dependencies (rag, auth, security)
# uv is 10-20x faster than pip and avoids the Deprecated/importlib-metadata hang
RUN uv pip install --prefix=/build/deps --no-cache .[rag,auth,security]

# -----------------------------------------------
# Stage 2: Runtime - Minimal production image
# -----------------------------------------------
FROM python:3.11-slim AS runtime

# Image metadata
LABEL maintainer="aiwithapex@example.com"
LABEL version="1.0.0"
LABEL description="Production-ready Agentic RAG Platform"
LABEL org.opencontainers.image.source="https://github.com/aiwithapex/base_agent"

WORKDIR /app

# Install only runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user with specific UID/GID for security
RUN groupadd -g 1001 appuser && \
    useradd -r -u 1001 -g appuser -s /sbin/nologin appuser

# Copy Python dependencies from builder
COPY --from=builder /build/deps /usr/local

# Copy application code
COPY --chown=appuser:appuser src/ ./src/
# SQL migrations are in src/agentic_rag/storage/migrations/sql/ (already copied above)
COPY --chown=appuser:appuser config/ ./config/
COPY --chown=appuser:appuser Makefile ./
COPY --chown=appuser:appuser pyproject.toml README.md ./

# Create necessary directories with proper permissions
RUN mkdir -p /app/data /app/logs && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose ports
EXPOSE 8502 8058 8002

# Health check endpoint (Streamlit UI)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8502/_stcore/health || exit 1

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    HOME=/app \
    STREAMLIT_SERVER_PORT=8502 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Default command (can be overridden)
CMD ["streamlit", "run", "src/ui/streamlit_app.py", "--server.port=8502", "--server.address=0.0.0.0"]

# -----------------------------------------------
# Stage 3: API Server - FastAPI service
# -----------------------------------------------
FROM runtime AS api

EXPOSE 8058

# Override health check for API
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8058/health || exit 1

# Run FastAPI server
CMD ["python", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8058"]
