[run]
source = src
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */.venv/*
    */migrations/*
    */config/*
    */examples/*
    */docs/*
    */setup.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    pass

precision = 2
show_missing = true
skip_covered = false

[html]
directory = htmlcov

[xml]
output = coverage.xml
